{
  "openapi": "3.1.1",
  "info": {
    "title": "VOID Network Static Discovery Mirror",
    "version": "2.0.0",
    "summary": "Read-only, source-bound static discovery for VOID Mainnet-0.",
    "description": "This GitHub Pages API is static distribution only. Canonical source is 6ZoSo9/void-node. It grants no mutation, wallet, payment, validator, Work Credit write, or funds authority."
  },
  "servers": [
    {
      "url": "https://6zoso9.github.io"
    }
  ],
  "paths": {
    "/current-state-v2.json": {
      "get": {
        "operationId": "getVoidMirrorCurrentState",
        "summary": "Get current mirror/source binding state.",
        "responses": {
          "200": {
            "description": "Current fail-closed mirror state."
          }
        }
      }
    },
    "/.well-known/void-public-node.json": {
      "get": {
        "operationId": "getVoidPublicNodeDiscovery",
        "summary": "Get canonical current public-node discovery mirrored from void-node.",
        "responses": {
          "200": {
            "description": "Current public-node discovery."
          }
        }
      }
    },
    "/.well-known/void-agent-discovery.json": {
      "get": {
        "operationId": "getVoidAgentDiscovery",
        "summary": "Get canonical agent discovery mirrored from void-node.",
        "responses": {
          "200": {
            "description": "Agent discovery contract."
          }
        }
      }
    },
    "/public-node/agents/first-contact-v1.json": {
      "get": {
        "operationId": "getVoidFirstContact",
        "summary": "Get current AI-agent First Contact contract.",
        "responses": {
          "200": {
            "description": "First Contact JSON."
          }
        }
      }
    },
    "/public-node/agents/capabilities-v1.json": {
      "get": {
        "operationId": "getVoidAgentCapabilities",
        "summary": "Get current capability-negotiation contract.",
        "responses": {
          "200": {
            "description": "Capabilities contract."
          }
        }
      }
    },
    "/public-node/agents/public-utility-v1.json": {
      "get": {
        "operationId": "getVoidAgentPublicUtility",
        "summary": "Get current public utility catalog.",
        "responses": {
          "200": {
            "description": "Public utility catalog."
          }
        }
      }
    },
    "/public-node/agents/paid-work-v1.json": {
      "get": {
        "operationId": "getVoidPaidWorkProtocol",
        "summary": "Get read-only paid-work protocol discovery.",
        "responses": {
          "200": {
            "description": "Paid-work protocol discovery; not a live submission endpoint."
          }
        }
      }
    },
    "/mirror/source-bindings-v2.json": {
      "get": {
        "operationId": "getVoidMirrorSourceBindings",
        "summary": "Get exact void-node Git blob bindings for mirrored contracts.",
        "responses": {
          "200": {
            "description": "Source binding manifest."
          }
        }
      }
    }
  },
  "security": [],
  "x-void-source": {
    "repository": "6ZoSo9/void-node",
    "commit": "d4a8f43462be30699678a2da710c427e38768655"
  },
  "x-void-boundary": {
    "staticDiscoveryOnly": true,
    "liveNode": false,
    "mutation": false,
    "wallet": false,
    "transactions": false,
    "payments": false,
    "workCreditWrite": false,
    "validatorMutation": false,
    "fundsMovement": false
  }
}
