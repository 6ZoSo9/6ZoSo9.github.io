  "client_algorithm": {
    "input": {
      "desired_capability_ids": {
        "items": "string",
        "type": "array",
        "unique": true
      }
    },
    "output": {
      "granted": "array of capability IDs",
      "not_granted": "array of capability IDs and reasons"
    },
    "steps": [
      "Fetch and validate the well-known discovery document.",
      "Fetch and validate the canonical discovery document.",
      "Resolve the advertised capability-negotiation path on the same origin.",
      "Fetch and validate this capability catalog.",
      "Grant only entries satisfying every advertised grant requirement.",
      "Return not_granted for unknown, disabled, guarded, planned, authenticated, ambiguous, malformed, or unverifiable entries."
    ]
