{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/public/public-node/agents/discovery-v1.schema.json",
  "title": "VOID AI Agent Discovery Contract Wall V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "protocol",
    "network",
    "purpose",
    "authority",
    "entrypoints",
    "capabilities",
    "agent_onboarding",
    "safety"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "marker": {
      "const": "VOID_AI_AGENT_DISCOVERY_CONTRACT_WALL_V1"
    },
    "protocol": {
      "const": "void-agent-discovery/1"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "chain_id"
      ],
      "properties": {
        "name": {
          "const": "VOID Mainnet-0"
        },
        "chain_id": {
          "const": 2050
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "granted_http_methods",
        "mutation_authority_granted",
        "credentials_required_for_discovery",
        "forbidden_assumptions"
      ],
      "properties": {
        "default": {
          "const": "read_only"
        },
        "granted_http_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD"
            ]
          }
        },
        "mutation_authority_granted": {
          "const": false
        },
        "credentials_required_for_discovery": {
          "const": false
        },
        "forbidden_assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^/"
      },
      "required": [
        "paid_work_protocol"
      ],
      "properties": {
        "paid_work_protocol": {
          "const": "/public-node/agents/paid-work-v1.json"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "live",
              "bounded_pilot",
              "guarded",
              "planned"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "discovery": {
            "type": "string",
            "pattern": "^/"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "id",
          "state",
          "authority",
          "discovery"
        ],
        "properties": {
          "id": {
            "const": "paid_work_protocol_discovery"
          },
          "state": {
            "const": "live"
          },
          "authority": {
            "const": "read_only"
          },
          "discovery": {
            "const": "/public-node/agents/paid-work-v1.json"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "agent_onboarding": {
      "type": "object",
      "required": [
        "steps",
        "stop_conditions"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": [
              "action",
              "method",
              "path",
              "required"
            ],
            "properties": {
              "action": {
                "const": "fetch"
              },
              "method": {
                "const": "GET"
              },
              "path": {
                "const": "/public-node/agents/paid-work-v1.json"
              },
              "required": {
                "const": false
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "same_origin_only",
        "follow_cross_origin_links_automatically",
        "send_secrets",
        "send_wallet_material",
        "send_operator_keys",
        "treat_unknown_capability_as"
      ],
      "properties": {
        "same_origin_only": {
          "const": true
        },
        "follow_cross_origin_links_automatically": {
          "const": false
        },
        "send_secrets": {
          "const": false
        },
        "send_wallet_material": {
          "const": false
        },
        "send_operator_keys": {
          "const": false
        },
        "treat_unknown_capability_as": {
          "const": "not_granted"
        }
      }
    }
  }
}
